<Configure class="org.eclipse.jetty.webapp.WebAppContext">
    <Set name="contextPath">/app</Set>
    <Set name="tempDirectory">/app/temp</Set>

    <!-- Configuración simplificada compatible con Jetty 9 -->
    <Call name="getSessionHandler">
        <Call name="setSessionTrackingModes">
            <Arg>
                <Array type="java.lang.String">
                    <Item>COOKIE</Item>
                </Array>
            </Arg>
        </Call>
    </Call>
</Configure>