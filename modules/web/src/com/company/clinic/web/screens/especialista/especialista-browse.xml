<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://especialistaBrowse.caption"
        focusComponent="especialistasTable"
        messagesPack="com.company.clinic.web.screens.especialista">
    <data>
        <collection id="especialistasDc"
                    class="com.company.clinic.entity.Especialista">
            <view extends="_local"/>
            <loader id="especialistasDl"/>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="especialistasTable"
            spacing="true">
        <!--<filter id="filter"
                applyTo="especialistasTable"
                dataLoader="especialistasDl">
            <properties include=".*"/>
        </filter>-->
        <groupBox id="filter" spacing="true">
            <vbox spacing="true">
                <hbox spacing="true">
                    <textField id="nombre" caption="Nombre" width="150px"/>
                    <textField id="apellidos" caption="Apellidos" width="200px"/>
                    <textField id="dni" caption="DNI" width="110px"/>
                    <lookupField id="especialidad" caption="Especialidad" width="150px"
                            optionsEnum="com.company.clinic.entity.Especialidad"/>
                    <button id="aplicar" caption="Aplicar" primary="true" shortcut="ENTER" align="BOTTOM_CENTER"/>
                    <button id="limpiar" caption="Limpiar" align="BOTTOM_CENTER"/>
                </hbox>
            </vbox>
        </groupBox>
        <groupTable id="especialistasTable"
                    width="100%"
                    dataContainer="especialistasDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="nombre"/>
                <column id="apellidos"/>
                <column id="dni"/>
                <column id="especialidad"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="viewBtn" caption="Ver" icon="font-icon:EYE"/>
                <button id="createBtn" caption="Crear" icon="font-icon:BOOK" primary="true"/>
                <button id="editBtn" caption="Editar" icon="font-icon:PENCIL"/>
                <button id="removeBtn" caption="Borrar" icon="font-icon:TRASH" stylename="danger"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
